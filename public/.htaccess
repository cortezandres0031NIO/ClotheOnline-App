RewriteEngine On
RewriteCond %{HTTP_HOST} ^armario\.qmascore\.net(?::[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://armario.qmascore.net%{REQUEST_URI} [R=308,L]

Require all granted
Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
